# Copy to .env and adjust for your machine. Never commit .env.

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bazaare

# Required. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The admin account is created (or its password reset) from these on startup.
# Leave either blank and no admin account is touched.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Image uploads go to Cloudflare R2 when all five are set (otherwise to instance/uploads).
# Token: R2 > Manage API tokens > "Object Read & Write" on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public address: a custom domain (https://media.example.com) or its r2.dev URL.
R2_PUBLIC_URL=

# Optional
# FLASK_DEBUG=1              # reloader + interactive debugger; local use only
# HOST=127.0.0.1             # set 0.0.0.0 to expose the site on your network
# PORT=8000
# SESSION_COOKIE_SECURE=1    # set when serving over HTTPS
# MAIL_SERVER=localhost
# MAIL_PORT=25
# MAIL_SENDER=no-reply@example.com

# Shipping labels through Shippo (US). Test keys start with shippo_test_ (sample labels, no charge).
# SHIPPO_API_KEY=
# Secret for the tracking webhook URL: https://<your-site>/webhooks/shippo?token=<this>
# SHIPPO_WEBHOOK_TOKEN=
# Ship-from address printed on labels:
# SHIP_FROM_NAME=
# SHIP_FROM_COMPANY=BazaarE'
# SHIP_FROM_STREET1=
# SHIP_FROM_STREET2=
# SHIP_FROM_CITY=
# SHIP_FROM_STATE=
# SHIP_FROM_ZIP=
# SHIP_FROM_PHONE=
# SHIP_FROM_EMAIL=
# Default parcel: length,width,height in inches, weight in ounces
# SHIP_PARCEL=9,6,1,4
