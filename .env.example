# Copy to .env and adjust for your machine. Never commit .env.

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bazaare

# Required. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The admin account is created (or its password reset) from these on startup.
# Leave either blank and no admin account is touched.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional
# FLASK_DEBUG=1              # reloader + interactive debugger; local use only
# HOST=127.0.0.1             # set 0.0.0.0 to expose the site on your network
# PORT=8000
# SESSION_COOKIE_SECURE=1    # set when serving over HTTPS
# MAIL_SERVER=localhost
# MAIL_PORT=25
# MAIL_SENDER=no-reply@example.com
